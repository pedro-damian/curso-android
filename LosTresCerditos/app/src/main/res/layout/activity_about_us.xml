<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_comida2"
    tools:context=".AboutUs">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="15dp"
        android:padding="15dp" >

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quienes Somos?"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />



        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/historia" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historia"
            android:textColor="@color/white"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />



        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="La historia de Tres Cerditos comienza en el año 2015, en un modesto local en Pueblo Libre, Lima, cuando tres hermanos – Jorge, Martín y Ricardo Ramírez – decidieron unir sus talentos para crear algo único: un restaurante que honrara las raíces de la cocina peruana, pero con un concepto divertido, familiar y lleno de cariño.

De pequeños, sus padres los llamaban cariñosamente “los tres cerditos” porque siempre estaban juntos y, sobre todo, ¡porque les encantaba comer! Ese apodo se convirtió en símbolo de unión, ternura y un amor compartido por la comida criolla."
            android:textColor="@color/white"
            android:layout_marginTop="15dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="left" />




    </androidx.appcompat.widget.LinearLayoutCompat>

</ScrollView>