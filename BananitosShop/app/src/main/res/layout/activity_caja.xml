<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_ropa3"
    tools:context=".Caja">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="15dp"
        android:padding="10dp" >

    <TextView
        android:id="@+id/textView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CAJA"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha"
        android:textColor="@color/white"
        android:layout_marginTop="15dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="left" />

    <EditText
        android:id="@+id/etFecha"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:hint="ingrese fecha (dd/mm/yyyy)"
        android:textSize="14sp"
        android:layout_marginTop="3dp"
        android:background="@color/white"
        android:paddingHorizontal="10dp"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saldo Inicial"
        android:textColor="@color/white"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="left" />

    <EditText
        android:id="@+id/etSaldo"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:hint="ingrese saldo"
        android:textSize="14sp"
        android:layout_marginTop="3dp"
        android:background="@color/white"
        android:paddingHorizontal="10dp"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresos"
        android:textColor="@color/white"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:gravity="start"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbRetiros"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Retiros de Bancos"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRetiros"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:inputType="numberDecimal"
                android:textSize="14sp" />

        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="start"
        >
        <CheckBox
            android:id="@+id/cbVentas"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="Ventas"
            android:textColor="@color/white"
            android:textStyle="bold"
            />

        <EditText
            android:id="@+id/etVentas"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@color/white"
            android:enabled="false"
            android:gravity="center"
            android:hint="monto"
            android:textSize="14sp" />
    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="start"
            >
            <CheckBox
                android:id="@+id/cbCreditos"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Creditos Cobrados"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/etCreditos"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:textSize="14sp" />
        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gastos"
            android:textColor="@color/white"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="start"
            >
            <CheckBox
                android:id="@+id/cbAlquiler"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Alquiler"
                android:textColor="@color/white"
                android:textStyle="bold"

                />

            <EditText
                android:id="@+id/etAlquiler"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="start"
            >
            <CheckBox
                android:id="@+id/cbLuz"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Luz"
                android:textColor="@color/white"
                android:textStyle="bold"

                />

            <EditText
                android:id="@+id/etLuz"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="start"
            >
            <CheckBox
                android:id="@+id/cbAgua"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Agua"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/etAgua"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="start"
            >
            <CheckBox
                android:id="@+id/cbImpuestos"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Impuestos"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/etImpuestos"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="start"
            >
            <CheckBox
                android:id="@+id/cbEmpleados"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Pago Empleados"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/etEmpleados"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="start"
            >
            <CheckBox
                android:id="@+id/cbOtros"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Otros"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/etOtros"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/white"
                android:enabled="false"
                android:gravity="center"
                android:hint="monto"
                android:textSize="14sp" />
        </LinearLayout>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            >

            <Button
                android:id="@+id/btnNuevo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:backgroundTint="#48c9b0"
                android:text="Nuevo"


                app:icon="@drawable/autorenew_24"
                app:iconTintMode="multiply" />

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#e74c3c "
                android:text="Calcular"
                app:icon="@drawable/calculate_24" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalles"
            android:textColor="@color/white"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="left" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/white"
            android:gravity="left"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            android:textStyle="bold" />





    </androidx.appcompat.widget.LinearLayoutCompat>


</ScrollView>